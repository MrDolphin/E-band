<section id=3D"general">
<h3 data-imt-p=3D"1">=E2=97=8FGeneral<a class=3D"headerlink" href=3D"https:=
//antsdr-docs.microphase.cn/en/latest/device_and_usage_manual/ANTSDR_E_Seri=
es_Module/ANTSDR_E310_Reference_Manual/AntsdrE310_gnurdio.html#general" tit=
le=3D"Permalink to this heading">=EF=83=81</a></h3>
