ages/matlab_pluto_demo.png"></p>
<p data-imt-p=3D"1">Select <strong>Open Model</strong> to launch the Simuli=
nk diagram.</p>
<p><img alt=3D"E310" src=3D"https://antsdr-docs.microphase.cn/en/latest/_im=
ages/matlab_ADALM-PLUTO.png"></p>
<p data-imt-p=3D"1">Double-click the <strong>ADALM-PLUTO Receiver block</st=
rong> to configure the settings. In the dialog, set the Radio ID to:</p>
<div class=3D"highlight-default notranslate"><div class=3D"highlight"><pre>=
<span></span><span class=3D"n">ip</span><span class=3D"p">:</span><span cla=
ss=3D"mf">192.168.1.10</span>
</pre></div>
</div>
<p data-imt-p=3D"1">Then click <strong>Apply</strong>, and then click <stro=
ng>Info</strong> to see the information of the current device.</p>
<p><img alt=3D"E310" src=3D"https://antsdr-docs.microphase.cn/en/latest/_im=
ages/matlab_demo_infoip.png"></p>
<p><img alt=3D"E310" src=3D"https://antsdr-docs.microphase.cn/en/latest/_im=
ages/matlab_demo_info.png"></p>
</section>
<section id=3D"connect-to-matlab-using-fmcomms-mirror">
<h3 data-imt-p=3D"1">=E2=97=8FConnect to MATLAB Using FMCOMMS Mirror<a clas=
s=3D"headerlink" href=3D"https://antsdr-docs.microphase.cn/en/latest/device=
_and_usage_manual/ANTSDR_E_Series_Module/ANTSDR_E310_Reference_Manual/Antsd=
rE310_matlab.html#connect-to-matlab-using-fmcomms-mirror" title=3D"Permalin=
k to this heading">=EF=83=81</a></h3>
<p data-imt-p=3D"1">If you are unfamiliar with using FMCOMMS images on the =
E310, please refer to the <a class=3D"reference internal" href=3D"https://a=
ntsdr-docs.microphase.cn/en/latest/device_and_usage_manual/ANTSDR_E_Series_=
Module/ANTSDR_E310_Reference_Manual/AntsdrE310_fmcomms.html"><span class=3D=
"doc">ANTSDR FMCOMMS</span></a> chapter first.
In this section, MATLAB R2021a is used and recommended.</p>
<p data-imt-p=3D"1">Open MATLAB and download the version-compatible toolkit=
 from <a class=3D"reference external" href=3D"https://github.com/analogdevi=
cesinc/TransceiverToolbox/releases">this GitHub page</a>. Then, double-clic=
k the downloaded <code class=3D"docutils literal notranslate"><span class=
=3D"pre">.mltbx</span></code> file in MATLAB to install the toolbox.</p>
<p data-imt-p=3D"1">Set the host computer IP to <code class=3D"docutils lit=
eral notranslate"><span class=3D"pre">192.168.1.100</span></code>, ensuring=
 it is on the same subnet as the device. Confirm connectivity by pinging th=
e device.
Create a new script in MATLAB and run the following code to test the connec=
tion:</p>
<div class=3D"highlight-default notranslate"><div class=3D"highlight"><pre>=
<span></span>clear all;

%% Tx set up
tx =3D adi.AD9361.Tx;=20
tx.uri =3D 'ip:192.168.1.10'; =20
tx.DataSource =3D 'DDS';  =20
tx.DDSFrequencies =3D [0 0; 1e5 1e5];=20
tx.DDSPhases =3D [0 0; 180e3 0];=20
tx.DDSScales =3D [0 0; 1 1];=20
tx.CenterFrequency =3D 2.4e9;=20
tx.RFPortSelect =3D 'B';
tx();
pause(1);      =20

%% Rx set up
rx =3D adi.AD9361.Rx('uri','ip:192.168.1.10');
rx.CenterFrequency =3D tx.CenterFrequency;
rx.EnabledChannels =3D [1,2];
rx.GainControlModeChannel0 =3D 'manual';
rx.GainControlModeChannel1 =3D 'manual';
rx.GainChannel0 =3D 50;
rx.GainChannel1 =3D 50;
rx.SamplingRate =3D 3e6;
y =3D rx();  =20

tx.release();
rx.release(); %=E9=87=8A=E6=94=BE=E8=B5=84=E6=BA=90

%=E5=B0=86=E8=A1=B0=E5=87=8F=E5=99=A8=E8=BF=9E=E6=8E=A5=E5=9C=A8TX1=E4=B8=
=8A=EF=BC=8C=E8=BF=9E=E6=8E=A5=E4=B8=80=E4=B8=AA1=E5=88=862=E6=8E=A5=E5=88=
=B0rx=E4=B8=8A
out=3Dy';
figure(1);=20
plot(real(out(1,1:1000)));
hold on;
plot(imag(out(1,1:1000)));
figure(2)=20
plot(real(out(2,1:1000)));
hold on;
plot(imag(out(2,1:1002)))
</pre></div>
</div>
